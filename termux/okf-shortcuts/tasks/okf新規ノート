#!/data/data/com.termux/files/usr/bin/bash
# フォルダを一覧から選び、タイトル・本文・タグを Gboard で入力して新しいノートを作る（ファイル名はタイトル）。
. "$HOME/.config/pocket/env" 2>/dev/null
[ -d "${OKF_BUNDLE:-}" ] || { termux-toast "ウィジェットの「okfバンドルを選ぶ」でバンドルを選んでください"; exit 1; }

ask() { termux-dialog text "$@" | jq -r 'select(.code == -1) | .text // empty'; }

# 置き場所。日誌・添付・テンプレートは除き、「雑記」があれば先頭にする（分類できない短いメモの置き場）
mapfile -t dirs < <(find "$OKF_BUNDLE/" -mindepth 1 -maxdepth 1 -type d ! -name '.*' ! -name 日記 ! -name 添付 ! -iname templates -printf '%f\n' | sort | awk '$0 == "雑記" { print; next } { rest = rest $0 "\n" } END { printf "%s", rest }')
folder=
if [ ${#dirs[@]} -gt 0 ]; then
	labels=$( { printf '%s\n' "${dirs[@]}"; echo "（いちばん上）"; } | sed 's/,/，/g' | paste -sd,)
	idx=$(termux-dialog sheet -t "新規ノート: フォルダ" -v "$labels" | jq -r '.index // empty')
	[ -z "$idx" ] && exit 0
	[ "$idx" -lt ${#dirs[@]} ] && folder="${dirs[$idx]}/"
fi

title=$(ask -t "新規ノート: ${folder:-（いちばん上）}" -i "タイトル")
[ -z "$title" ] && exit 0
body=$(ask -m -t "新規ノート: 本文" -i "本文（空でも可）")
tags=$(ask -t "新規ノート: タグ" -i "タグ（カンマ区切り、空でも可）")

id="$folder${title//\//-}"
args=(--title "$title")
[ -n "$tags" ] && args+=(--tag "${tags//，/,}")
if out=$(okf new "$OKF_BUNDLE" "$id" "${args[@]}" --body - <<<"${body:-# $title}" 2>&1 >/dev/null); then
	termux-toast "作成しました: $id.md"
else
	termux-notification --id pocket-okf -t "ノートを作れませんでした" -c "$out"
fi
