#!/data/data/com.termux/files/usr/bin/bash
# okf のバンドルをフォルダの一覧から選び直す（場所を変えたときもこれで選ぶ）。
. "$HOME/.config/pocket/env" 2>/dev/null
dir=$(pocket-pick-dir "okf のバンドルを選ぶ" "${OKF_BUNDLE:-}") || {
	[ $? = 2 ] && termux-toast "先に Termux で termux-setup-storage を実行してください"
	exit 0
}
pocket-setconf OKF_BUNDLE "$dir"
n=$(okf list "$dir" --json 2>/dev/null | jq -r '.count // 0')
termux-toast "okf のバンドルを設定しました（ノート $n 件）: 内部ストレージ${dir#"$HOME/storage/shared"}"
