#!/data/data/com.termux/files/usr/bin/bash
# 内部ストレージのフォルダを一覧でたどって okf のバンドルを選び、~/.config/pocket/env に書く。
# バンドルの場所を変えたときもこれで選び直す（パスを打たずに済む）。
CONF=$HOME/.config/pocket/env
root=$HOME/storage/shared
[ -d "$root" ] || { termux-toast "先に Termux で termux-setup-storage を実行してください"; exit 1; }

dir=$root
while :; do
	mapfile -t subs < <(find "$dir/" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' | sort)
	here=${dir#"$root"}
	opts=("✅ ここにする（内部ストレージ${here:-}）")
	[ "$dir" != "$root" ] && opts+=("⬆ 上のフォルダへ")
	for s in "${subs[@]}"; do opts+=("📁 $s"); done
	# sheet の選択肢はカンマ区切りなので、名前の中のカンマは全角にする
	labels=$(printf '%s\n' "${opts[@]}" | sed 's/,/，/g' | paste -sd,)
	idx=$(termux-dialog sheet -t "okf のバンドルを選ぶ" -v "$labels" | jq -r '.index // empty')
	[ -z "$idx" ] && exit 0
	[ "$idx" = 0 ] && break
	if [ "$dir" != "$root" ]; then
		[ "$idx" = 1 ] && { dir=$(dirname "$dir"); continue; }
		idx=$((idx - 1))
	fi
	dir="$dir/${subs[$((idx - 1))]}"
done

mkdir -p "$(dirname "$CONF")"
{ grep -v '^OKF_BUNDLE=' "$CONF" 2>/dev/null; printf 'OKF_BUNDLE="%s"\n' "$dir"; } >"$CONF.new" && mv "$CONF.new" "$CONF"
n=$(okf list "$dir" --json 2>/dev/null | jq -r '.count // 0')
termux-toast "okf のバンドルを設定しました（ノート $n 件）: ${dir#"$root"/}"
