#!/data/data/com.termux/files/usr/bin/bash
# Gboard で書いた文章を、時刻つきの箇条書きで今日のデイリーノートの末尾に足す。
# ノートがなければ Templates/daily.md から作る。
. "$HOME/.config/pocket/env" 2>/dev/null
[ -d "${OKF_BUNDLE:-}" ] || { termux-toast "OKF_BUNDLE を ~/.config/pocket/env に設定してください"; exit 1; }

text=$(termux-dialog text -m -t "今日のノートに追記" -i "改行もできます" | jq -r 'select(.code == -1) | .text // empty')
[ -z "$text" ] && exit 0

today=$(date +%F)
f="$OKF_BUNDLE/$today.md"
if [ ! -e "$f" ]; then
	fm=$(printf -- '---\njournal: daily\njournal-date: %s\n---\n' "$today")
	if ! err=$(okf new "$OKF_BUNDLE" "$today" --template daily --body - <<<"$fm" 2>&1 >/dev/null); then
		termux-toast "ノートを作れませんでした: $err"; exit 1
	fi
fi

# 直前が箇条書きでも空行でもなければ、空行を挟んでからリストを始める
[ -n "$(tail -c1 "$f")" ] && echo >>"$f"
last=$(tail -n1 "$f")
[[ -z $last || $last == "- "* || $last == "  "* ]] || echo >>"$f"
printf -- '- %s %s\n' "$(date +%H:%M)" "${text//$'\n'/$'\n  '}" >>"$f"
termux-toast "$today.md に追記しました"
